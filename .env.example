# ===== 后端 =====
DATABASE_URL=postgresql+psycopg://homekb:homekb@localhost:5432/homekb
STORAGE_BACKEND=local          # local | supabase | gcs | r2
STORAGE_LOCAL_DIR=./data/files
JOB_RUNNER=poller              # poller | cloudrun_job
EMBEDDING_PROVIDER=local_bge_m3  # local_bge_m3 | api
LLM_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000

# ===== 前端（frontend/.env.local） =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=1         # 1 = 使用前端内置的示例数据，后端未就绪时用
